rules_version = '2';

/* Storage — matched to firestore.rules on 2026-09-17. Reads stay public so the
 * TV displays and menu boards can load images and video by download URL with
 * no sign-in; uploads and deletes need a signed-in user. */
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
